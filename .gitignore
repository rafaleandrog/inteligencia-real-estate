node_modules/
.DS_Store
*.log
.env
.env.*
.idea/
.vscode/

# Saída do conversor de migração — gerada por `npm run migrate:csv`.
# Não versionada: seria uma terceira cópia dos mesmos dados que já estão em
# migration/ (semente) e data/demo.json (fallback). Ver docs/ENGINEERING_RULES.md R2.4.
migration-csv/

# Screenshots gerados pelo smoke test (tools/smoke-test.mjs) — artefato local, nunca versionado.
desktop.png
mobile.png
meta.png

# Configuração local do Claude Code (permissões por máquina). Nunca versionada:
# conceder permissão é decisão de quem opera a máquina, não do repositório.
.claude/
*.local.mjs

# Pipeline de dados públicos (pipeline/): downloads brutos, logs de execução e ambiente
# virtual nunca entram no repositório — só a saída validada em data/public/ (R2.7).
pipeline/.cache/
pipeline/.venv/
__pycache__/
*.pyc
*.egg-info/
# Credencial que google-github-actions/auth materializa no workspace (R4.10).
gha-creds-*.json
# Modelo 2 (warehouse/): bruto, staging e o banco DuckDB ficam fora; só marts pequenos entram.
warehouse/raw/
warehouse/staging/
warehouse/*.duckdb
