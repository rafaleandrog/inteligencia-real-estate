{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaleandrog.github.io/inteligencia-real-estate/data/public/schemas/ra_aggregates.schema.json",
  "title": "ra_aggregates.json — agregados por Região Administrativa (uma linha por RA_nn)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ra_geo_id", "ra_geo_id_roman", "ra_name", "ra_area_km2", "quality_flags"],
        "properties": {
          "ra_geo_id": { "type": "string", "pattern": "^RA_[0-9]{2}$" },
          "ra_geo_id_roman": { "type": "string", "pattern": "^RA2026_RA-[IVXLC]+$" },
          "ra_name": { "type": "string" },
          "ra_area_km2": { "type": ["number", "null"] },
          "households_source": { "type": ["string", "null"] },
          "households_2010": { "type": ["integer", "null"] },
          "households_2022": { "type": ["integer", "null"] },
          "households_delta": { "type": ["integer", "null"] },
          "households_growth_pct": { "type": ["number", "null"], "description": "fração decimal: 0.12 = +12 %" },
          "households_per_km2_2022": { "type": ["number", "null"] },
          "pop_2010": { "type": ["integer", "null"] },
          "pop_2022": { "type": ["integer", "null"] },
          "cells_2010": { "type": ["integer", "null"] },
          "cells_2022": { "type": ["integer", "null"] },
          "cells_partial": { "type": ["integer", "null"] },
          "jobs_source": { "type": ["string", "null"] },
          "jobs_year": { "type": ["integer", "null"] },
          "jobs_total": { "type": ["integer", "null"] },
          "jobs_low": { "type": ["integer", "null"] },
          "jobs_mid": { "type": ["integer", "null"] },
          "jobs_high": { "type": ["integer", "null"] },
          "jobs_population_basis": { "type": ["integer", "null"] },
          "jobs_per_1000_residents": { "type": ["number", "null"] },
          "jobs_per_km2": { "type": ["number", "null"] },
          "hexes": { "type": ["integer", "null"] },
          "centrality_source": { "type": ["string", "null"] },
          "centrality_snapshot": { "type": ["string", "null"] },
          "edges_total": { "type": ["integer", "null"] },
          "road_km_total": { "type": ["number", "null"] },
          "road_km_top_decile": { "type": ["number", "null"] },
          "centrality_mean": { "type": ["number", "null"] },
          "centrality_p90": { "type": ["number", "null"] },
          "quality_flags": { "type": "array", "items": { "enum": ["households_missing", "jobs_missing", "centrality_missing", "partial_children", "households_growth_suppressed"] } }
        }
      }
    }
  }
}
