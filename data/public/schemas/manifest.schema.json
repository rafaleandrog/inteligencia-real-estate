{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rafaleandrog.github.io/inteligencia-real-estate/data/public/schemas/manifest.schema.json",
  "title": "manifest.json — índice dos arquivos públicos derivados",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "generated_at", "pipeline_version", "pipeline_commit", "config_sha256", "attribution_pt", "datasets"],
  "properties": {
    "manifest_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "pipeline_version": { "type": "string" },
    "pipeline_commit": { "type": "string" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attribution_pt": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_pt", "version", "generated_at", "content_hash", "years", "crs", "files", "sources", "method_pt", "counts", "quality_flags", "notes_pt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "title_pt": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "generated_at": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "schema": { "type": "string", "pattern": "^schemas/[a-z0-9_.-]+\\.schema\\.json$" },
          "years": { "type": "array", "items": { "type": "integer" } },
          "crs": { "const": "EPSG:4326" },
          "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "bytes", "budget_bytes", "sha256", "features"],
              "properties": {
                "path": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.json$" },
                "role": { "enum": ["overview", "detail", "detail_shard", "data"] },
                "bytes": { "type": "integer", "minimum": 1 },
                "budget_bytes": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "features": { "type": "integer", "minimum": 0 },
                "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
                "shard_key": { "type": "string" },
                "shard_value": { "type": "string" },
                "zoom_min": { "type": "integer", "minimum": 0, "maximum": 22 }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "url", "retrieved_at", "license", "attribution_pt"],
              "properties": {
                "name": { "type": "string" },
                "url": { "type": "string", "pattern": "^https?://" },
                "retrieved_at": { "type": "string" },
                "license": { "type": "string" },
                "license_url": { "type": "string" },
                "attribution_pt": { "type": "string" },
                "files": { "type": "array", "items": { "type": "string" } },
                "etag": { "type": ["string", "null"] },
                "sha256": { "type": "string" },
                "bytes": { "type": "integer" },
                "last_modified": { "type": ["string", "null"] }
              }
            }
          },
          "method_pt": { "type": "string" },
          "ra_assignment_method": { "enum": ["centroid_within_ra", "midpoint_within_ra"] },
          "class_breaks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["method", "breaks", "classes"],
              "properties": {
                "method": { "enum": ["fixed"] },
                "breaks": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
                "classes": { "type": "integer", "minimum": 2 },
                "n": { "type": "integer", "minimum": 0 },
                "zero_is_absent": { "type": "boolean" }
              }
            }
          },
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "quality_flags": { "type": "array", "items": { "type": "string" } },
          "notes_pt": { "type": "string" }
        }
      }
    }
  }
}
